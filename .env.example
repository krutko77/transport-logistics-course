PORT=3000
NODE_ENV=production

# Email руководителя — куда отправлять результаты тестов
MANAGER_EMAIL=руководитель@example.com

# Resend API (resend.com → API Keys) — предпочтительный способ отправки
RESEND_API_KEY=re_...
RESEND_FROM=Тест по логистике <noreply@example.com>

# SMTP — резервный способ отправки, если нет Resend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_password_here
